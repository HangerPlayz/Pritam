# Copy to .env and fill in. NEVER commit .env or put these values in frontend code.
PORT=3000
# How often the server re-checks the platforms (seconds, minimum 15)
CACHE_TTL_SECONDS=45

# YouTube Data API v3 key  (Google Cloud Console → APIs & Services → Credentials)
YOUTUBE_API_KEY=
# Channels to watch for live streams (handles, comma separated)
YOUTUBE_CHANNELS=@pritamisliveff,@proton_live

# Twitch app  (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_LOGIN=pritamislive07

# Kick app  (Kick account settings → Developer → create app; https://docs.kick.com)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_SLUG=pritamislive07
